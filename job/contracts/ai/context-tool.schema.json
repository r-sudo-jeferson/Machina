{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machina.local/contracts/ai/context-tool.schema.json",
  "title": "Machina Context Read Tool Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["question"],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "locale": {
      "type": "string",
      "enum": ["en-US", "pt-BR"]
    }
  }
}
